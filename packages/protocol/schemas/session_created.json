{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionCreatedMessage",
  "type": "object",
  "required": ["type", "session_id", "timestamp", "protocol_version", "payload"],
  "properties": {
    "type": { "const": "session_created" },
    "session_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "protocol_version": { "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["server_max_steps"],
      "properties": {
        "server_max_steps": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

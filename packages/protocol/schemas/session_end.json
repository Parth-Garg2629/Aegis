{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionEndMessage",
  "type": "object",
  "required": ["type", "session_id", "timestamp", "protocol_version", "payload"],
  "properties": {
    "type": { "const": "session_end" },
    "session_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "protocol_version": { "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["reason", "final_step"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "goal_achieved",
            "agent_failed",
            "user_cancelled",
            "max_steps_reached",
            "stuck_detected",
            "repeated_failures",
            "connection_error"
          ]
        },
        "final_step": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

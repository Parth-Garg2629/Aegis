{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionResumedMessage",
  "type": "object",
  "required": ["type", "session_id", "timestamp", "protocol_version", "payload"],
  "properties": {
    "type": { "const": "session_resumed" },
    "session_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "protocol_version": { "const": "1.0" },
    "payload": {
      "type": "object",
      "required": ["resumed"],
      "properties": {
        "resumed": { "type": "boolean" },
        "server_step": { "type": ["integer", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
